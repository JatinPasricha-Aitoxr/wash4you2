.DS_Store
.research/
dist/
dist-edit/
dist2/
node_modules/
__pycache__/
*.pyc

# Client-supplied source material (~2.2 GB). Several videos exceed GitHub's
# 100 MB hard file limit, so committing this would break pushes outright.
# Keep it locally; extract what the site needs into src/assets/images/.
docs/

# Local screenshot output from tools/shot.mjs
shots/

# Throwaway puppeteer/screenshot scripts. These must live in the repo root to
# resolve node_modules, so they are easy to leave behind — two were committed
# by accident. Anything matching these is scratch, never site source.
.*.mjs
.shot.tmp.mjs

# Control plane (admin/) — local dev DB and secrets, never committed.
admin/admin.db
admin/.env
admin/__pycache__/
admin/**/__pycache__/
admin/.pytest_cache/

# Client-supplied source folders (62 MB, already duplicates of images on the site). Kept locally only.
client-assets/

# Admin app (cms/): dependencies, local env, local sqlite + downloaded editor build.
cms/node_modules/
cms/.env
cms/data/
