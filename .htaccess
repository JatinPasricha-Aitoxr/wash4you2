Options -MultiViews
RewriteEngine On

# 1. www -> non-www
RewriteCond %{HTTP_HOST} ^www\.wash4you\.in$ [NC]
RewriteRule ^ https://wash4you.in%{REQUEST_URI} [R=301,L]

# 2. Collapse double slashes (//pricing/ -> /pricing/)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^?\s]*?)//+([^?\s]*)
RewriteRule ^ https://wash4you.in%1/%2 [R=301,L,NE]

# 3. index.html -> folder URL
RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^?\s]*/)index\.html[\s?] [NC]
RewriteRule ^ https://wash4you.in%1 [R=301,L,NE]

# 4. Duplicate pages -> the page that should rank
RewriteRule ^best-dryclean-near-me/?$ https://wash4you.in/best-dryclean-in-gurgaon/ [R=301,L]
RewriteRule ^pricing/(sushant-lok|sector-49|cyber-city|dlf-phase-3|golf-course-road|golf-course-extension|sohna-road|sector-29|palam-vihar|mg-road)/?$ https://wash4you.in/pricing/ [R=301,L]
RewriteRule ^services/premium-dry-cleaning/?$ https://wash4you.in/services/premium-dry-cleaning-best-premium-drycleaning-service/ [R=301,L]
# Old service URLs (they used to be noindex stubs with a meta-refresh)
RewriteRule ^services/eco-friendly-laundry/?$ https://wash4you.in/services/eco-friendly-laundry-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/shoe-cleaning/?$ https://wash4you.in/services/shoe-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/bag-cleaning/?$ https://wash4you.in/services/bag-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/leather-cleaning/?$ https://wash4you.in/services/leather-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/curtains-cleaning/?$ https://wash4you.in/services/curtains-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/carpet-cleaning/?$ https://wash4you.in/services/carpet-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/toy-cleaning/?$ https://wash4you.in/services/toy-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/accessories-cleaning/?$ https://wash4you.in/services/accessories-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/sofa-cleaning/?$ https://wash4you.in/services/sofa-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/steam-ironing/?$ https://wash4you.in/services/steam-ironing-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/mattress-cleaning/?$ https://wash4you.in/services/mattress-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/wet-cleaning/?$ https://wash4you.in/services/wet-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/blanket-quilt-cleaning/?$ https://wash4you.in/services/blanket-quilt-cleaning-best-premium-drycleaning-service/ [R=301,L]
RewriteRule ^services/linen-cleaning/?$ https://wash4you.in/services/linen-cleaning-best-premium-drycleaning-service/ [R=301,L]

# 5. Browser caching for static files.
# CSS and JS links carry a per-build ?v= token (src/build.py `asset_v`), so
# they are safe to cache for a year. Images and fonts are NOT versioned by
# URL, so they get 30 days (Task 9.1 fallback) and a changed file reaches
# returning visitors within a month.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
